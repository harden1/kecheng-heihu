<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.badItem.mapper.CreateBadItemsTableMapper">
    
    <resultMap type="CreateBadItemsTable" id="CreateBadItemsTableResult">
        <result property="id"    column="id"    />
        <result property="badName"    column="bad_name"    />
        <result property="badColor"    column="bad_color"    />
        <result property="no"    column="no"    />
        <result property="state"    column="state"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectCreateBadItemsTableVo">
        select id, bad_name, bad_color, no, state, create_by, create_time, update_by, update_time from create_bad_items_table
    </sql>

    <select id="selectCreateBadItemsTableList" parameterType="CreateBadItemsTable" resultMap="CreateBadItemsTableResult">
        <include refid="selectCreateBadItemsTableVo"/>
        <where>  
            <if test="badName != null  and badName != ''"> and bad_name like concat('%', #{badName}, '%')</if>
            <if test="badColor != null  and badColor != ''"> and bad_color = #{badColor}</if>
            <if test="no != null "> and no = #{no}</if>
            <if test="state != null  and state != ''"> and state = #{state}</if>
        </where>
    </select>
    
    <select id="selectCreateBadItemsTableById" parameterType="Long" resultMap="CreateBadItemsTableResult">
        <include refid="selectCreateBadItemsTableVo"/>
        where id = #{id}
    </select>

    <insert id="insertCreateBadItemsTable" parameterType="CreateBadItemsTable">
        insert into create_bad_items_table
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="badName != null">bad_name,</if>
            <if test="badColor != null">bad_color,</if>
            <if test="no != null">no,</if>
            <if test="state != null">state,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="badName != null">#{badName},</if>
            <if test="badColor != null">#{badColor},</if>
            <if test="no != null">#{no},</if>
            <if test="state != null">#{state},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateCreateBadItemsTable" parameterType="CreateBadItemsTable">
        update create_bad_items_table
        <trim prefix="SET" suffixOverrides=",">
            <if test="badName != null">bad_name = #{badName},</if>
            <if test="badColor != null">bad_color = #{badColor},</if>
            <if test="no != null">no = #{no},</if>
            <if test="state != null">state = #{state},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCreateBadItemsTableById" parameterType="Long">
        delete from create_bad_items_table where id = #{id}
    </delete>

    <delete id="deleteCreateBadItemsTableByIds" parameterType="String">
        delete from create_bad_items_table where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>