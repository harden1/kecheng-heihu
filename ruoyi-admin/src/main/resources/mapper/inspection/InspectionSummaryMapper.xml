    <delete id="deleteInspectionSummaryById" parameterType="Long">
        delete from inspection_summary where id = #{id}
    </delete>

    <delete id="deleteInspectionSummaryByIds" parameterType="String">
        delete from inspection_summary where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteInspectionReportBySummaryIds" parameterType="String">
        delete from inspection_report where summary_id in 
        <foreach item="summaryId" collection="array" open="(" separator="," close=")">
            #{summaryId}
        </foreach>
    </delete>

    <delete id="deleteInspectionReportBySummaryId" parameterType="Long">
