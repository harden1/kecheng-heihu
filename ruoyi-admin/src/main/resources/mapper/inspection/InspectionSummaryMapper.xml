        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.summaryId}, #{item.workOrderCode}, #{item.reportTime}, #{item.reportType}, #{item.quantity}, #{item.resultJson}, #{item.successFlag}, #{item.defectRemark}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime})
